{
  "version": 2,
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/api/index"
    },
    {
      "source": "/stream/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/configure",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
